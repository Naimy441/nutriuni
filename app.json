{
  "expo": {
    "name": "nutriuni",
    "slug": "nutriuni",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/nutriuni.png",
    "scheme": "nutriuni",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Track your nutrition at Duke University dining locations",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutriuni.app",
      "buildNumber": "8",
      "icon": {
        "light": "./assets/images/nutriuni.png",
        "dark": "./assets/images/nutriuni-dark.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "nutriuni",
        "NSCameraUsageDescription": "This app does not use the camera.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nutriuni.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nutriuni.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/nutriuni.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nutriuni.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/nutriuni-dark.png",
            "backgroundColor": "#0A0E0C"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fceb7098-e65f-4400-9641-88482b309de0"
      }
    },
    "owner": "abdullahnaim"
  }
}
